{
  "name": "linkpad",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Your personal bookmark manager — save, tag, filter, find.",
  "author": "LinkPad",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "BASE_URL=/linkpad/ vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON=true vite build && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "ELECTRON=true vite build && electron-builder --config electron-builder.json",
    "electron:build:win": "ELECTRON=true vite build && electron-builder --win --config electron-builder.json",
    "electron:build:mac": "ELECTRON=true vite build && electron-builder --mac --config electron-builder.json"
  },
  "dependencies": {
    "dexie": "^3.2.4",
    "lucide-react": "^0.400.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4"
  }
}
